{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "lazy-github-plan": {
      "description": "lazy-workflow GitHub planning authority: documents and slices, no tracker or delivery effects.",
      "mode": "primary",
      "permission": {
        "edit": "allow",
        "bash": {
          "gh issue create*": "deny",
          "gh issue edit*": "deny",
          "git push*": "deny",
          "git branch*": "deny",
          "git checkout -b*": "deny",
          "git switch -c*": "deny",
          "git remote*": "deny",
          "git tag*": "deny",
          "gh pr*": "deny",
          "gh repo*": "deny",
          "gh api*": "deny",
          "az*": "deny"
        }
      }
    },
    "lazy-github-code": {
      "description": "lazy-workflow GitHub delivery authority: implement, validate, commit. Every remote effect belongs to the coordinator.",
      "mode": "primary",
      "permission": {
        "edit": "allow",
        "bash": {
          "git push*": "deny",
          "git branch*": "deny",
          "git checkout -b*": "deny",
          "git switch -c*": "deny",
          "git remote*": "deny",
          "git tag*": "deny",
          "gh pr*": "deny",
          "gh repo*": "deny",
          "gh api*": "deny",
          "gh issue edit*": "deny",
          "gh issue close*": "deny",
          "gh issue reopen*": "deny",
          "gh issue comment*": "deny",
          "gh issue delete*": "deny",
          "gh issue transfer*": "deny",
          "gh issue lock*": "deny",
          "gh issue unlock*": "deny",
          "az*": "deny"
        }
      }
    },
    "lazy-azure-plan": {
      "description": "lazy-workflow Azure planning authority: HU documentation and a returned plan. The coordinator publishes the work items.",
      "mode": "primary",
      "permission": {
        "edit": "allow",
        "bash": {
          "git push*": "deny",
          "git branch*": "deny",
          "git checkout -b*": "deny",
          "git switch -c*": "deny",
          "git remote*": "deny",
          "git tag*": "deny",
          "az*": "deny",
          "gh*": "deny"
        }
      }
    },
    "lazy-azure-code": {
      "description": "lazy-workflow Azure delivery authority: implement, validate, commit, write the manifest. The coordinator owns Azure and every remote effect.",
      "mode": "primary",
      "permission": {
        "edit": "allow",
        "bash": {
          "git push*": "deny",
          "git branch*": "deny",
          "git checkout -b*": "deny",
          "git switch -c*": "deny",
          "git remote*": "deny",
          "git tag*": "deny",
          "az*": "deny",
          "gh*": "deny"
        }
      }
    },
    "lazy-review": {
      "description": "lazy-workflow review authority: read the tree and report. Modifies nothing.",
      "mode": "primary",
      "permission": {
        "edit": "deny",
        "bash": {
          "git push*": "deny",
          "git commit*": "deny",
          "git add*": "deny",
          "git rm*": "deny",
          "git mv*": "deny",
          "git branch*": "deny",
          "git checkout*": "deny",
          "git switch*": "deny",
          "git merge*": "deny",
          "git rebase*": "deny",
          "git reset*": "deny",
          "git restore*": "deny",
          "git revert*": "deny",
          "git cherry-pick*": "deny",
          "git clean*": "deny",
          "git stash*": "deny",
          "git apply*": "deny",
          "git tag*": "deny",
          "git remote*": "deny",
          "gh pr*": "deny",
          "gh issue*": "deny",
          "gh repo*": "deny",
          "gh api*": "deny",
          "az*": "deny"
        }
      }
    },
    "lazy-setup": {
      "description": "lazy-workflow setup authority: configure the machine lz runs on. No repository edit, git or tracker mutation, workflow run or secret read.",
      "mode": "primary",
      "permission": {
        "bash": {
          "az boards*": "deny",
          "az pipelines*": "deny",
          "az repos*": "deny",
          "az rest*": "deny",
          "gh api*": "deny",
          "gh issue*": "deny",
          "gh pr*": "deny",
          "gh repo*": "deny",
          "git add*": "deny",
          "git apply*": "deny",
          "git branch*": "deny",
          "git checkout*": "deny",
          "git cherry-pick*": "deny",
          "git clean*": "deny",
          "git commit*": "deny",
          "git merge*": "deny",
          "git mv*": "deny",
          "git push*": "deny",
          "git rebase*": "deny",
          "git remote*": "deny",
          "git reset*": "deny",
          "git restore*": "deny",
          "git revert*": "deny",
          "git rm*": "deny",
          "git stash*": "deny",
          "git switch*": "deny",
          "git tag*": "deny",
          "lz code*": "deny",
          "lz credentials-get*": "deny",
          "lz plan*": "deny",
          "lz setup*": "deny"
        },
        "edit": "deny"
      }
    }
  }
}
