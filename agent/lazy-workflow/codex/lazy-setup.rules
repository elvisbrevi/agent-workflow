# lazy-workflow setup authority: configure the machine lz runs on — binaries,
# logins and lz's stored environment — and nothing else. No repository edit,
# no git or tracker mutation, no workflow run and no secret printed.
# Hand-written from ADR-0021; not generated from opencode/authority.json or
# claudecode/*.json.

prefix_rule(pattern=["apply_patch"], decision="forbidden")
prefix_rule(pattern=["git", "push"], decision="forbidden")
prefix_rule(pattern=["git", "commit"], decision="forbidden")
prefix_rule(pattern=["git", "add"], decision="forbidden")
prefix_rule(pattern=["git", "rm"], decision="forbidden")
prefix_rule(pattern=["git", "mv"], decision="forbidden")
prefix_rule(pattern=["git", "branch"], decision="forbidden")
prefix_rule(pattern=["git", "checkout"], decision="forbidden")
prefix_rule(pattern=["git", "switch"], decision="forbidden")
prefix_rule(pattern=["git", "merge"], decision="forbidden")
prefix_rule(pattern=["git", "rebase"], decision="forbidden")
prefix_rule(pattern=["git", "reset"], decision="forbidden")
prefix_rule(pattern=["git", "restore"], decision="forbidden")
prefix_rule(pattern=["git", "revert"], decision="forbidden")
prefix_rule(pattern=["git", "cherry-pick"], decision="forbidden")
prefix_rule(pattern=["git", "clean"], decision="forbidden")
prefix_rule(pattern=["git", "stash"], decision="forbidden")
prefix_rule(pattern=["git", "apply"], decision="forbidden")
prefix_rule(pattern=["git", "tag"], decision="forbidden")
prefix_rule(pattern=["git", "remote"], decision="forbidden")
prefix_rule(pattern=["gh", "pr"], decision="forbidden")
prefix_rule(pattern=["gh", "issue"], decision="forbidden")
prefix_rule(pattern=["gh", "repo"], decision="forbidden")
prefix_rule(pattern=["gh", "api"], decision="forbidden")
prefix_rule(pattern=["az", "boards"], decision="forbidden")
prefix_rule(pattern=["az", "repos"], decision="forbidden")
prefix_rule(pattern=["az", "pipelines"], decision="forbidden")
prefix_rule(pattern=["az", "rest"], decision="forbidden")
prefix_rule(pattern=["lz", "plan"], decision="forbidden")
prefix_rule(pattern=["lz", "code"], decision="forbidden")
prefix_rule(pattern=["lz", "setup"], decision="forbidden")
prefix_rule(pattern=["lz", "credentials-get"], decision="forbidden")
