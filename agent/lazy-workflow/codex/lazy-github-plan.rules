# lazy-workflow GitHub planning authority: documents and tracker work, no delivery effects.
# Hand-written from ADR-0021; not generated from opencode/authority.json or claudecode/*.json.

prefix_rule(pattern=["git", "push"], decision="forbidden")
prefix_rule(pattern=["git", "branch"], decision="forbidden")
prefix_rule(pattern=["git", "checkout", "-b"], decision="forbidden")
prefix_rule(pattern=["git", "checkout", "-B"], decision="forbidden")
prefix_rule(pattern=["git", "checkout", "--orphan"], decision="forbidden")
prefix_rule(pattern=["git", "switch", "-c"], decision="forbidden")
prefix_rule(pattern=["git", "switch", "-C"], decision="forbidden")
prefix_rule(pattern=["git", "switch", "--create"], decision="forbidden")
prefix_rule(pattern=["git", "switch", "--force-create"], decision="forbidden")
prefix_rule(pattern=["git", "remote"], decision="forbidden")
prefix_rule(pattern=["git", "tag"], decision="forbidden")
prefix_rule(pattern=["gh", "pr"], decision="forbidden")
prefix_rule(pattern=["gh", "repo"], decision="forbidden")
prefix_rule(pattern=["gh", "api"], decision="forbidden")
prefix_rule(pattern=["az"], decision="forbidden")
